{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
      "app": {
        "root": ".",
        "framework": "vite"
      },
      "asni-blog": {
        "root": "asni-blog",
        "framework": "sanity"
      }
    },
    "rewrites": [
      {
        "source": "/studio",
        "destination": {
          "service": "asni-blog"
        }
      },
      {
        "source": "/studio/(.*)",
        "destination": {
          "service": "asni-blog"
        }
      },
      {
        "source": "/(.*)",
        "destination": {
          "service": "app"
        }
      }
    ]
  }